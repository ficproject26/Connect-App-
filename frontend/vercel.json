{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://connect-app-7s6g.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://connect-app-7s6g.onrender.com/uploads/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://connect-app-7s6g.onrender.com/socket.io/:path*"
    },
    {
      "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
