{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.ficapp.in/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.ficapp.in/uploads/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://api.ficapp.in/socket.io/:path*"
    },
    {
      "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
